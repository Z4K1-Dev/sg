generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String?
  role          UserRole         @default("USER")
  avatar        String?
  bio           String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  activities    ActivityLog[]
  notifications Notification[]
  posts         Post[]
  responses     ReportResponse[]
  reports       Report[]

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  type        PostType  @default("POST")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  posts       Post[]

  @@map("categories")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  posts     PostTag[]

  @@map("tags")
}

model Post {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  content         String?
  excerpt         String?
  categoryId      String?
  type            PostType    @default("POST")
  status          PostStatus  @default("DRAFT")
  metaTitle       String?
  metaDescription String?
  featuredImage   String?
  authorId        String
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  media           PostMedia[]
  tags            PostTag[]
  category        Category?   @relation(fields: [categoryId], references: [id])
  author          User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model PostTag {
  id        String   @id @default(cuid())
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  parentId  String?
  path      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  media     Media[]
  parent    MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("MediaFolderChildren")

  @@map("media_folders")
}

model Media {
  id           String        @id @default(cuid())
  filename     String
  originalName String
  path         String
  size         Int
  mimeType     String
  type         MediaType     @default("OTHER")
  alt          String?
  title        String?
  description  String?
  width        Int?
  height       Int?
  folderId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  folder       MediaFolder?  @relation(fields: [folderId], references: [id])
  posts        PostMedia[]
  reports      ReportMedia[]

  @@map("media")
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  mediaId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@map("post_media")
}

model Status {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#6c757d")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reports     Report[]

  @@map("statuses")
}

model Report {
  id          String           @id @default(cuid())
  title       String
  description String
  location    String?
  lat         Float?
  lng         Float?
  address     String?
  statusId    String
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  media       ReportMedia[]
  responses   ReportResponse[]
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  status      Status           @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model ReportMedia {
  id        String   @id @default(cuid())
  reportId  String
  mediaId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, mediaId])
  @@map("report_media")
}

model ReportResponse {
  id          String   @id @default(cuid())
  content     String
  reportId    String
  responderId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  responder   User     @relation(fields: [responderId], references: [id], onDelete: Cascade)
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_responses")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  type        String   @default("string")
  category    String   @default("general")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default("INFO")
  userId    String?
  isRead    Boolean          @default(false)
  data      String?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  action      String
  entityId    String?
  entityType  String?
  description String
  userId      String?
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  user        User?        @relation(fields: [userId], references: [id])

  @@map("activity_logs")
}

model Backup {
  id          String    @id @default(cuid())
  filename    String
  path        String
  size        Int
  type        String    @default("full")
  status      String    @default("pending")
  description String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("backups")
}

enum UserRole {
  ADMIN
  OPERATOR
  USER
}

enum PostType {
  POST
  PAGE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum ReportStatus {
  BARU
  DIPROSES
  DITUNDA
  SELESAI
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum ActivityType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}
