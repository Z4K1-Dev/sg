// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserRole {
  ADMIN
  OPERATOR
  USER
}

enum PostType {
  POST
  PAGE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum ReportStatus {
  BARU
  DIPROSES
  DITUNDA
  SELESAI
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum ActivityType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// MODELS

// Users table with soft delete support
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  role        UserRole @default(USER)
  avatar      String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  posts       Post[]
  reports     Report[]
  responses   ReportResponse[]
  activities  ActivityLog[]
  notifications Notification[]

  @@map("users")
}

// Categories table with soft delete support
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        PostType @default(POST)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  posts Post[]

  @@map("categories")
}

// Tags table with soft delete support
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  posts PostTag[]

  @@map("tags")
}

// Posts table with soft delete support
model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  content        String?
  excerpt        String?
  categoryId     String?
  type           PostType   @default(POST)
  status         PostStatus @default(DRAFT)
  metaTitle      String?
  metaDescription String?
  featuredImage  String?
  authorId       String
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  // Relations
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags      PostTag[]
  media     PostMedia[]

  @@map("posts")
}

// Post Tags junction table
model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String
  createdAt DateTime @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

// Media Folders table with soft delete support
model MediaFolder {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  parentId    String?
  path        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  parent   MediaFolder? @relation("MediaFolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("MediaFolderChildren")
  media    Media[]

  @@map("media_folders")
}

// Media table with soft delete support
model Media {
  id          String    @id @default(cuid())
  filename    String
  originalName String
  path        String
  size        Int
  mimeType    String
  type        MediaType  @default(OTHER)
  alt         String?
  title       String?
  description String?
  width       Int?
  height      Int?
  folderId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  posts   PostMedia[]
  reports ReportMedia[]

  @@map("media")
}

// Post Media junction table
model PostMedia {
  id       String @id @default(cuid())
  postId   String
  mediaId  String
  position Int    @default(0)
  createdAt DateTime @default(now())

  // Relations
  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@map("post_media")
}

// Statuses table for dynamic status management
model Status {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#6c757d")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  reports Report[]

  @@map("statuses")
}

// Reports table with soft delete support
model Report {
  id          String       @id @default(cuid())
  title       String
  description String
  location    String?
  lat         Float?
  lng         Float?
  address     String?
  statusId    String
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  // Relations
  status    Status          @relation(fields: [statusId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  responses ReportResponse[]
  media     ReportMedia[]

  @@map("reports")
}

// Report Media junction table
model ReportMedia {
  id       String @id @default(cuid())
  reportId String
  mediaId  String
  position Int    @default(0)
  createdAt DateTime @default(now())

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  media  Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([reportId, mediaId])
  @@map("report_media")
}

// Report Responses table
model ReportResponse {
  id          String   @id @default(cuid())
  content     String
  reportId    String
  responderId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  responder User   @relation(fields: [responderId], references: [id], onDelete: Cascade)

  @@map("report_responses")
}

// Settings table for global configuration
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  type        String   @default("string") // string, number, boolean, json
  category    String   @default("general")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

// Notifications table
model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(INFO)
  userId    String?
  isRead    Boolean          @default(false)
  data      String?          // JSON data for additional info
  createdAt DateTime         @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// Activity Logs table
model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  action      String
  entityId    String?
  entityType  String?
  description String
  userId      String?
  metadata    String?      // JSON data for additional info
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

// Backups table
model Backup {
  id          String   @id @default(cuid())
  filename    String
  path        String
  size        Int
  type        String   @default("full") // full, incremental
  status      String   @default("pending") // pending, completed, failed
  description String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@map("backups")
}